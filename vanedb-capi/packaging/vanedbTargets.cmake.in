# Generated by scripts/package_capi.py from vanedb-capi/packaging/vanedbTargets.cmake.in.
#
# Two imported targets over the same header:
#   vanedb::shared  the shared library, loaded at run time;
#   vanedb::static  the static library, plus the system libraries the Rust
#                   standard library needs, recorded at package time from
#                   `cargo rustc --print native-static-libs`.
if(TARGET vanedb::shared)
  return()
endif()

add_library(vanedb::shared SHARED IMPORTED)
set_target_properties(vanedb::shared PROPERTIES
  IMPORTED_LOCATION "${_vanedb_prefix}/lib/@SHARED_LIBRARY@"
  INTERFACE_INCLUDE_DIRECTORIES "${_vanedb_prefix}/include")
@IMPORT_LIBRARY_PROPERTY@
add_library(vanedb::static STATIC IMPORTED)
set_target_properties(vanedb::static PROPERTIES
  IMPORTED_LOCATION "${_vanedb_prefix}/lib/@STATIC_LIBRARY@"
  INTERFACE_INCLUDE_DIRECTORIES "${_vanedb_prefix}/include"
  INTERFACE_LINK_LIBRARIES "@STATIC_LINK_LIBRARIES@")
