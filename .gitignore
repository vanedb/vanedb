/target
# Root Cargo.lock is committed because release builds use --locked.

# WASM build output
vanedb-wasm/pkg/

# Python
__pycache__/
*.py[cod]
*.pyo

# `maturin develop` writes the compiled extension into the python-source
# directory next to the stubs, so it sits in the tree rather than in target/.
vanedb-py/python/vanedb/*.so
vanedb-py/python/vanedb/*.pyd
vanedb-py/python/vanedb/*.dylib

# Benchmark scratch files: the benches run from the repository root and build
# their mmap stores on a real filesystem (see bench/benches/mmap.rs).
*.mmap
*.bin
# Test fixtures are the exception: a committed byte file is the whole point of
# a format-compatibility test, and `*.bin` above silently ate the first one.
!vanedb/tests/fixtures/*.bin
!conformance/**/*.bin

# Swept in by `git add -A` and never intentional: stray shell redirects,
# and per-developer editor configuration.
/0
.zed/
.idea/
*.code-workspace
